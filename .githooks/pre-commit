#!/bin/bash
# Pre-commit guardrails. One-time setup per clone:
#   git config core.hooksPath .githooks
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

PYTHON="${ROOT}/venvs/audio/bin/python"
if [[ ! -x "$PYTHON" ]]; then
  PYTHON=python3
fi

"$PYTHON" scripts/guardrails.py
# GT-yaml must still derive from its committed .als (manifest-free slot-label
# gate). Redundant with guardrails but surfaces a drift's slot diff directly;
# self-guards to a no-op for any gated set whose committed .als is absent.
"$PYTHON" -m labeling.verify.gt_als_gate
bash scripts/typecheck.sh
"$PYTHON" -m pytest tests/ -q
