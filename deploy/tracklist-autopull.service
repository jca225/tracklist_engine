# tracklist_engine auto-pull — sync this pi's checkout with origin/main (no-clobber).
# Mechanical remediation for issue #73. Triggered by tracklist-autopull.timer.
#
# Install (per pi, one-time):
#   sudo cp deploy/tracklist-autopull.service /etc/systemd/system/
#   sudo cp deploy/tracklist-autopull.timer   /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tracklist-autopull.timer
#
[Unit]
Description=tracklist_engine auto-pull (sync checkout with origin/main, no-clobber) — issue #73
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=johncabrahams
WorkingDirectory=/home/johncabrahams/tracklist_engine
ExecStart=/home/johncabrahams/tracklist_engine/scripts/pi_autopull.sh
# Restarting jobqueue needs passwordless `sudo systemctl restart` (already
# configured on the cluster — same rule `make restart-jobqueue` relies on).
