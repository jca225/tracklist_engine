# Periodic trigger for tracklist-autopull.service — keeps the pi in sync with
# origin/main so it never silently drifts N commits behind (issue #73).
[Unit]
Description=Run tracklist_engine auto-pull every 10 min — issue #73

[Timer]
OnBootSec=2min
OnUnitActiveSec=10min
Persistent=true

[Install]
WantedBy=timers.target
