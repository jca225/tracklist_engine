[Unit]
Description=Tracklist Engine — corpus data-integrity check (ERROR exit = structural corruption in the canonical DB)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=johncabrahams
WorkingDirectory=/home/johncabrahams/tracklist_engine
# Exits non-zero when any ERROR-severity invariant is violated, so a failed run
# is a sticky alert: it shows in `systemctl --failed` / `make status` until the
# next clean run. journald captures the full report (see logs-corpus-integrity).
ExecStart=/home/johncabrahams/tracklist_engine/venvs/audio/bin/python scripts/corpus_integrity.py --db /mnt/storage/data/db/music_database.db --no-samples
