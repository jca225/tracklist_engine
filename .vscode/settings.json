{
  "python-envs.defaultEnvManager": "ms-python.python:system",
  "python.defaultInterpreterPath": "${workspaceFolder}/venvs/audio/bin/python",
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "venvs": true,
    "data": true,
    "logs": true,
    "profiles": true,
    "reports": true,
    "deploy": true,
    "cue-detr": true,
    ".claude/worktrees": true,

    // Generated tool caches — regenerable, never hand-edited.
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.hypothesis": true,
    "**/.lm_cache": true,
    "**/.DS_Store": true,

    // Tool config you don't hand-edit day to day. .github / .gitignore /
    // .vscode / .claude stay visible on purpose — files.exclude also removes
    // entries from Cmd-P quick-open, so hiding those would cost more than the
    // clutter. Add ".*": true here if you want every dotfile gone.
    ".cursor": true,
    ".githooks": true,
    ".streamlit": true,
    ".superpowers": true,
    ".env": true
  },
  "search.exclude": {
    "venvs": true,
    "data": true,
    "archive": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.hypothesis": true,
    "**/.lm_cache": true
  }
}
