{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alignment_algorithm.local/schemas/download_request.json",
  "title": "DownloadRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates", "process_name", "process_version"],
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "minLength": 1 },
          "rank": { "type": "integer" },
          "source": { "type": "string" }
        }
      }
    },
    "process_name": { "type": "string" },
    "process_version": { "type": "string" },
    "expected_duration_s": { "type": ["number", "null"] }
  }
}
