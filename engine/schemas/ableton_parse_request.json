{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alignment_algorithm.local/schemas/ableton_parse_request.json",
  "title": "AbletonParseRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["als_uri", "process_name", "process_version"],
  "properties": {
    "als_uri": { "type": "string", "minLength": 1 },
    "permitted_audio_uris": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "process_name": { "type": "string" },
    "process_version": { "type": "string" }
  }
}
