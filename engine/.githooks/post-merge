#!/bin/bash
# Post-merge parse check (advisory). Runs after `git merge` / `git pull`.
# After rebase, run `make land-verify` yourself — git has no post-rebase hook.
#
# Enable once the repo is under git:
#   git config core.hooksPath .githooks
set -uo pipefail

if ! command -v braid >/dev/null 2>&1; then
  exit 0
fi

if ! braid verify --since 'HEAD@{1}'; then
  echo ""
  echo "  ^ merge produced code that does not parse. Inspect before push."
  echo "    Then: make check && make land-verify"
fi
exit 0
